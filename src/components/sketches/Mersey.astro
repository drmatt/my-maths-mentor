---
import Sketch from '../Sketch.astro';
import { photo } from '../../lib/photos';

// A sketch map of where the Goyt and the Tame meet to form the Mersey (viewBox 0 0 400 320).
const blocks = [
  [40, 96, 34, 22], [84, 88, 26, 30], [120, 226, 40, 24], [60, 232, 30, 20], [170, 250, 28, 26],
  [256, 120, 30, 20], [300, 160, 26, 22], [252, 214, 28, 22], [330, 112, 22, 16],
];
const ticks = Array.from({ length: 11 }, (_, i) => 24 + i * 12);
---

<Sketch
  label="Sketch map of the River Goyt and River Tame joining to form the River Mersey in Stockport, with the note Goyt plus Tame equals Mersey and a map scale of 1 to 25,000."
  viewBox="0 0 400 320"
  photo={photo('mersey')}
  tilt={1.5}
>
  <g slot="art">
    <path d="M0 108C80 118 160 96 250 70M30 300C120 250 200 240 300 250M150 0C160 80 140 200 168 320" class="ink ink--thin" opacity="0.25"></path>
    {blocks.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} rx="3" class="f-sun-tint s-teal s-thin" opacity="0.9" />)}
    <path d="M412 28C350 58 300 110 232 168" fill="none" stroke="#B5A5E4" stroke-width="13" stroke-linecap="round"></path>
    <path d="M412 300C350 282 300 232 232 168" fill="none" stroke="#B5A5E4" stroke-width="13" stroke-linecap="round"></path>
    <path d="M232 168C182 140 132 196 72 172S12 140 -12 150" fill="none" stroke="#B5A5E4" stroke-width="19" stroke-linecap="round"></path>
    <path d="M330 72C300 96 270 126 246 150M330 266C300 246 270 210 246 184M212 160C176 148 140 184 92 176" class="s-cream" opacity="0.7"></path>
    <path d="M372 166V136" class="ink ink--thin"></path>
    <path d="M366 144l6-8 6 8" class="ink ink--thin"></path>
    <text x="366" y="128" class="hand" font-size="18">N</text>
  </g>
  <g slot="notes">
    <text x="16" y="38" class="hand fade" font-size="29" style="--d:.2s">Goyt + Tame = Mersey</text>
    <text x="18" y="63" class="hand hand--accent fade" font-size="18" style="--d:.5s">the Mersey begins here, in Stockport</text>
    <path d="M168 72C200 92 216 120 226 152" class="ink ink--thin draw" pathLength="1" style="--d:.8s"></path>
    <path d="M218 145l8 9 3-12" class="ink ink--thin fade" style="--d:1.4s"></path>
    <circle cx="232" cy="168" r="9" class="ink fade" style="--d:1.3s"></circle>

    <text x="318" y="54" class="hand fade" font-size="20" style="--d:1s">Tame</text>
    <text x="300" y="300" class="hand fade" font-size="20" style="--d:1.1s">Goyt</text>
    <text x="22" y="208" class="hand fade" font-size="20" style="--d:1.2s">Mersey</text>

    <rect x="24" y="266" width="120" height="16" rx="2" class="f-paper ink ink--thin fade" style="--d:1.6s"></rect>
    {ticks.map((x, i) => <path d={`M${x} 266v${i % 5 === 0 ? 9 : 5}`} class="ink ink--thin fade" style="--d:1.6s;stroke-width:1.2" />)}
    <text x="24" y="304" class="hand fade" font-size="17" style="--d:1.8s">on a 1 : 25 000 map, 4 cm = 1 km</text>
  </g>
</Sketch>
