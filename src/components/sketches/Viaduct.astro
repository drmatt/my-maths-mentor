---
import Sketch from '../Sketch.astro';
import { photo } from '../../lib/photos';

interface Props {
  eager?: boolean;
  tilt?: number;
}

const { eager = false, tilt = -1.5 } = Astro.props;

// Geometry for the illustration (viewBox 0 0 640 480).
const r = 58; // arch radius
const spring = 250; // springing line (where each arch starts)
const ground = 420;
const deck = 150;
const centres = [-52, 92, 236, 380, 524, 668];
const openings = centres
  .map((c) => `M${c - r} ${ground}V${spring}A${r} ${r} 0 0 1 ${c + r} ${spring}V${ground}Z`)
  .join('');
const structure = `M-200 ${deck}H840V${ground}H-200Z${openings}`;
const rings = centres
  .map((c) => `M${c - r - 11} ${spring}A${r + 11} ${r + 11} 0 0 1 ${c + r + 11} ${spring}`)
  .join('');
const windows = [384, 404, 424, 464, 484, 504, 544, 564];
---

<Sketch
  label="Sketch of Stockport Viaduct. One arch is marked up as a semicircle with x and y axes, a radius r, a span of 2r and the equation x squared plus y squared equals r squared."
  viewBox="0 0 640 480"
  photo={photo('viaduct')}
  tilt={tilt}
  tape
  eager={eager}
  todo="viaduct photo"
>
  <g slot="art">
    <defs>
      <pattern id="vd-bricks" width="20" height="12" patternUnits="userSpaceOnUse">
        <path d="M0 11.5H20M0 5.5H20M10 0V5.5M0 5.5V11.5M20 5.5V11.5" fill="none" stroke="#244B52" stroke-width="0.8" opacity="0.35"></path>
      </pattern>
    </defs>
    <circle cx="560" cy="74" r="34" class="f-sun s-teal"></circle>
    <path d="M560 22v-10M560 136v-10M508 74h-10M622 74h-10M523 37l-7-7M597 37l7-7" class="ink ink--thin"></path>
    <rect x="-10" y="420" width="660" height="70" class="f-lilac" opacity="0.55"></rect>
    <path d="M24 446q10-6 20 0t20 0M118 462q10-6 20 0t20 0M262 450q10-6 20 0t20 0M410 464q10-6 20 0t20 0M520 444q10-6 20 0t20 0" class="s-cream"></path>
    <path d={structure} class="f-coral" fill-rule="evenodd"></path>
    <path d={structure} fill="url(#vd-bricks)" fill-rule="evenodd"></path>
    <path d={rings} class="ink ink--thin" opacity="0.55"></path>
    <path d={structure} fill="none" class="s-teal" fill-rule="evenodd"></path>
    <path d="M-10 162H650" class="ink ink--thin" opacity="0.7"></path>
    <g>
      <rect x="372" y="124" width="74" height="26" rx="6" class="f-teal"></rect>
      <rect x="452" y="124" width="74" height="26" rx="6" class="f-teal"></rect>
      <path d="M532 150V130q0-6 6-6h52q14 0 20 14l4 12Z" class="f-teal"></path>
      {windows.map((x) => <rect x={x} y="131" width="12" height="8" rx="2" class="f-sun" />)}
    </g>
  </g>
  <g slot="notes">
    <text x="30" y="70" class="hand fade" font-size="46" style="--d:.15s">x² + y² = r²</text>
    <text x="32" y="100" class="hand hand--accent fade" font-size="21" style="--d:.45s">if the arch were a perfect semicircle…</text>
    <path d="M146 112C176 130 196 152 205 184" class="ink draw" pathLength="1" style="--d:.7s"></path>
    <path d="M196 177l9 10 4-13" class="ink fade" style="--d:1.5s"></path>

    <circle cx="236" cy="250" r={r} class="ink ink--thin ink--dash fade" style="--d:.9s"></circle>

    <path d="M166 250H314" class="ink draw" pathLength="1" style="--d:1s"></path>
    <path d="M306 244l8 6-8 6" class="ink fade" style="--d:1.6s"></path>
    <text x="319" y="257" class="hand fade" font-size="24" style="--d:1.6s">x</text>
    <path d="M236 328V172" class="ink draw" pathLength="1" style="--d:1.1s"></path>
    <path d="M230 180l6-8 6 8" class="ink fade" style="--d:1.7s"></path>
    <text x="244" y="180" class="hand fade" font-size="24" style="--d:1.7s">y</text>

    <path d="M236 250L277 209" class="ink draw" pathLength="1" style="--d:1.4s;stroke-width:3"></path>
    <circle cx="236" cy="250" r="4" class="f-teal fade" style="--d:1.4s"></circle>
    <circle cx="277" cy="209" r="5" class="f-teal fade" style="--d:1.9s"></circle>
    <text x="244" y="228" class="hand fade" font-size="26" style="--d:1.9s">r</text>
    <text x="286" y="203" class="hand fade" font-size="20" style="--d:2s">(x, y)</text>

    <path d="M178 386H294" class="ink ink--thin draw" pathLength="1" style="--d:1.8s"></path>
    <path d="M178 378v16M294 378v16" class="ink ink--thin fade" style="--d:1.8s"></path>
    <text x="236" y="377" text-anchor="middle" class="hand fade" font-size="24" style="--d:2.1s">2r</text>

    <text x="22" y="468" class="hand fade" font-size="22" style="--d:.3s">Stockport Viaduct</text>
  </g>
</Sketch>
