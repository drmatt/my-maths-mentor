---
import { site, formEndpoint } from '../../site.config';
import { url } from '../../lib/url';
import ToConfirm from '../ToConfirm.astro';

const stages = ['Year 7', 'Year 8', 'Year 9', 'Home educated', 'Not currently attending school', 'Not sure / other'];
---

<section class="section section--coral section--grid" id="enquire" aria-labelledby="enquire-title">
  <div class="container split">
    <div class="enquiry-intro" data-reveal>
      <span class="kicker">Let’s have a chat</span>
      <h2 id="enquire-title">Every journey starts somewhere.</h2>
      <p class="lede">
        Whether your child needs a little extra support or a completely fresh start with maths, I’d love to hear from
        you.
      </p>
      <p class="contact-alt">Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a></p>
      {
        !site.emailConfirmed && (
          <ToConfirm>
            <p>{site.email} is the proposed address. It hasn’t been set up yet, so mail to it won’t arrive.</p>
          </ToConfirm>
        )
      }
    </div>

    <div class="form-card" data-reveal style="--rd:.1s">
      {
        !formEndpoint && (
          <ToConfirm>
            <p>
              The form isn’t connected yet. Add the Formspree form ID to <code>src/site.config.ts</code> to start
              receiving enquiries.
            </p>
          </ToConfirm>
        )
      }
      <form
        class="enquiry"
        action={formEndpoint || '#'}
        method="POST"
        data-enquiry
        data-endpoint={formEndpoint}
        data-email={site.email}
      >
        <input type="hidden" name="_subject" value="New enquiry from the My Maths Mentor website" />
        <div class="field field--hp" aria-hidden="true">
          <label for="f-gotcha">Leave this field empty</label>
          <input id="f-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field">
          <label for="f-name">Your name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-hint" />
          <p class="field__hint" id="f-name-hint">The parent or carer’s name, please.</p>
          <p class="field__error" id="f-name-error" hidden></p>
        </div>

        <div class="field">
          <label for="f-email">Email address</label>
          <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required />
          <p class="field__error" id="f-email-error" hidden></p>
        </div>

        <div class="field">
          <label for="f-stage">Your child’s school year or stage</label>
          <select id="f-stage" name="stage" required>
            <option value="">Please choose…</option>
            {stages.map((stage) => <option>{stage}</option>)}
          </select>
          <p class="field__error" id="f-stage-error" hidden></p>
        </div>

        <div class="field">
          <label for="f-times">Preferred days and times <span class="optional">(optional)</span></label>
          <input id="f-times" name="preferred_times" type="text" aria-describedby="f-times-hint" />
          <p class="field__hint" id="f-times-hint">For example, weekday mornings.</p>
        </div>

        <div class="field">
          <label for="f-message">Your message <span class="optional">(optional)</span></label>
          <textarea id="f-message" name="message" rows="5" aria-describedby="f-message-hint"></textarea>
          <p class="field__hint" id="f-message-hint">
            Tell me a little about how your child feels about maths. Please don’t include their full name, date of birth
            or any medical details; we can talk about anything important when we chat.
          </p>
        </div>

        <p class="form-privacy">
          Your details are only used to reply to your enquiry. See the <a href={url('/privacy/')}>privacy notice</a>.
        </p>
        <p class="form-status" role="status" aria-live="polite" hidden></p>
        <div>
          <button class="btn" type="submit">Send Emma a message <span class="btn__arrow" aria-hidden="true">→</span></button>
        </div>
      </form>

      <div class="form-success" data-enquiry-success hidden tabindex="-1">
        <svg viewBox="0 0 72 72" aria-hidden="true" focusable="false">
          <circle cx="36" cy="36" r="33" fill="#F6CD58" stroke="#244B52" stroke-width="3"></circle>
          <path d="M22 37l9 9 19-20" fill="none" stroke="#244B52" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <h3>Thank you, your message is on its way.</h3>
        <p>I’ll get back to you as soon as I can.</p>
      </div>
    </div>
  </div>
</section>
