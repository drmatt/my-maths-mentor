---
import '@fontsource-variable/fredoka';
import '@fontsource-variable/dm-sans';
import '@fontsource/caveat/500.css';
import '../styles/global.css';
import fredokaLatin from '@fontsource-variable/fredoka/files/fredoka-latin-wght-normal.woff2?url';
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import { site } from '../site.config';
import { url } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DraftBanner from '../components/DraftBanner.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('/og-image.png'), Astro.site).href;
const robots = site.draft || noindex ? 'noindex, nofollow' : 'index, follow';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#244B52" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap.xml')} />
    <link rel="preload" href={fredokaLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="My Maths Mentor: helping children find their confidence in maths again. Maths mentoring in Stockport." />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {site.draft && <DraftBanner />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
