---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { url } from '../lib/url';
---

<Base title={`Page not found | ${site.name}`} noindex>
  <section class="container not-found">
    <p class="equation" aria-hidden="true">4 + 0 + 4 = ?</p>
    <h1>This page doesn’t add up</h1>
    <p>The page you were looking for isn’t here. Let’s get you back to the start.</p>
    <p><a class="btn" href={url('/')}>Back to the home page</a></p>
  </section>
</Base>
